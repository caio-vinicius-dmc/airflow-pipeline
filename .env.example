# cp .env.example .env
# Ambiente local. Nenhum destes valores serve para produção.

# Usuário do host, para que os arquivos que o Airflow grava em logs/ não
# fiquem como root. No Linux: AIRFLOW_UID=$(id -u). No Windows, deixe 50000.
AIRFLOW_UID=50000

# Banco de metadados do Airflow e banco de destino da pipeline.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=15435

# Assina os tokens entre o api-server e os workers. Gere um valor próprio:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=troque_este_segredo_local

# Criptografa as senhas das Connections no banco de metadados. Precisa ser
# fixa: sem ela o Airflow gera uma chave nova a cada subida e as conexões
# gravadas antes deixam de ser legiveis (cryptography.fernet.InvalidToken).
# Gere a sua com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=troque_esta_chave_local

# Portas expostas no host.
AIRFLOW_PORT=18080
API_CLIMA_PORT=18000
